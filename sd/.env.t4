# ============================================================
# GPU profile: T4 (Turing, 16GB 显存)
# stable-diffusion.cpp 引擎专用（sd/ 目录）
#
# 用法:
#   由 sd/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=t4 时)
#   或手动: source .env.t4
# 以下变量均写成 ${VAR:-默认}: 外部(命令行/父 shell/.envrc)已设置时保持原值, 未设置才用本 profile 的默认值
# ============================================================

export SD_DIR="${SD_DIR:-/content/stable-diffusion.cpp}"

# ---- 默认模型: Qwen-Image-2.1 三件套(换更小档位以适应 16GB) ----
# 每项用 <VAR> 单值来源(hf:///https://huggingface.co/.../resolve/.../file://本地路径均可)
export SD_DIFFUSION_MODEL="${SD_DIFFUSION_MODEL:-hf://unsloth/Qwen-Image-2.1-GGUF/qwen-image-2.1-Q4_K_S.gguf}"
export SD_VAE="${SD_VAE:-hf://unsloth/Qwen-Image-2.1-FP8/vae/qwen_image_2.1_vae_bf16.safetensors}"
export SD_LLM="${SD_LLM:-hf://unsloth/Qwen3-VL-8B-Instruct-GGUF/Qwen3-VL-8B-Instruct-UD-Q3_K_XL.gguf}"

# 16GB 显存放不下三件套, 打开 CPU 卸载(权重留内存按需换入显存)
export SD_OFFLOAD_TO_CPU="${SD_OFFLOAD_TO_CPU:-1}"

# T4 无原生 flash attention, sd.cpp 会回退默认注意力; 保持关闭更稳
export SD_DIFFUSION_FA="${SD_DIFFUSION_FA:-0}"

# ---- 生成默认参数(显存有限, 降分辨率) ----
export SD_STEPS="${SD_STEPS:-20}"
export SD_CFG_SCALE="${SD_CFG_SCALE:-6.0}"
export SD_SAMPLING_METHOD="${SD_SAMPLING_METHOD:-euler}"
export SD_WIDTH="${SD_WIDTH:-768}"
export SD_HEIGHT="${SD_HEIGHT:-768}"

# ---- 服务监听 ----
export SD_HOST="${SD_HOST:-0.0.0.0}"
export SD_PORT="${SD_PORT:-30000}"

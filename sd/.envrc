# shellcheck shell=bash
# stable-diffusion.cpp 引擎目录的 direnv 配置
# 进入本目录时自动生效: 继承根目录 .envrc, 并按 GPU_PROFILE 加载对应 profile

# 继承父目录(根)的 .envrc(含 API_KEY / MODEL_ROOT / BORE_PORT / dotenv 等)
source_up

# 安装目录(源码编译或官方预编译均落在此处; 二进制在 $SD_DIR/build/bin)
SD_DIR="${SD_DIR:-/content/stable-diffusion.cpp}"
export SD_DIR
PATH_add "$SD_DIR/build/bin"

# ---- sd 引擎专属配置(均带 SD_ 前缀) ----
# 模型组件: 每项一个 <VAR> 单值来源(本地路径 / file:// / hf:// / HF https URL,
# 见 launch.sh parse_model_source; HF 来源下载到 HF 标准缓存
# ~/.cache/huggingface/hub/models--<org>--<repo>/snapshots/ 并定位真实文件路径)
export SD_MODEL="${SD_MODEL:-}"
export SD_DIFFUSION_MODEL="${SD_DIFFUSION_MODEL:-}"
export SD_VAE="${SD_VAE:-}"
export SD_LLM="${SD_LLM:-}"
export SD_LLM_VISION="${SD_LLM_VISION:-}"
export SD_CLIP_L="${SD_CLIP_L:-}"
export SD_CLIP_G="${SD_CLIP_G:-}"
export SD_T5XXL="${SD_T5XXL:-}"

# 生成参数: 不在这一层给非空默认值, 交由 profile 提供(launch.sh 另有兜底)
export SD_STEPS="${SD_STEPS:-}"
export SD_CFG_SCALE="${SD_CFG_SCALE:-}"
export SD_SAMPLING_METHOD="${SD_SAMPLING_METHOD:-}"
export SD_WIDTH="${SD_WIDTH:-}"
export SD_HEIGHT="${SD_HEIGHT:-}"
export SD_DIFFUSION_FA="${SD_DIFFUSION_FA:-}"
export SD_OFFLOAD_TO_CPU="${SD_OFFLOAD_TO_CPU:-}"
export SD_VAE_TILING="${SD_VAE_TILING:-}"
# 可选生成参数(留空则不传, 由 sd.cpp 决定)
export SD_SEED="${SD_SEED:-}"
export SD_SCHEDULER="${SD_SCHEDULER:-}"
export SD_FLOW_SHIFT="${SD_FLOW_SHIFT:-}"
export SD_NEGATIVE_PROMPT="${SD_NEGATIVE_PROMPT:-}"

# 服务监听与运行时
export SD_HOST="${SD_HOST:-0.0.0.0}"
export SD_PORT="${SD_PORT:-30000}"
export SD_THREADS="${SD_THREADS:-}"
export SD_LORA_DIR="${SD_LORA_DIR:-}"
export SD_LOG_LEVEL="${SD_LOG_LEVEL:-}"

# 一次性出图(generate)输出目录与默认提示词
export SD_OUTPUT_DIR="${SD_OUTPUT_DIR:-/content/outputs}"
export SD_PROMPT="${SD_PROMPT:-a lovely cat}"
export SD_BATCH_COUNT="${SD_BATCH_COUNT:-1}"
export SD_REQUEST_TIMEOUT="${SD_REQUEST_TIMEOUT:-1800}"

# 按 GPU_PROFILE 加载对应 profile(g4 / t4 / cpu)
# 未显式设置时自动探测: 有 NVIDIA 显卡按型号推导(g4 / t4); 没有 nvidia-smi 或无输出则落到 cpu
_gpu_profile="${GPU_PROFILE:-}"
if [[ -z "$_gpu_profile" ]]; then
  _gpu_name=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    _gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)
  fi
  case "$_gpu_name" in
    *T4*)                  _gpu_profile=t4 ;;
    *G4*|*L4*|*Blackwell*) _gpu_profile=g4 ;;   # Blackwell 系(如 RTX PRO 6000)按 G4 处理
    "")                    _gpu_profile=cpu ;;   # 无 nvidia-smi 或无输出: 纯 CPU 平台
    # 有显卡但型号未识别: 不套用任何 profile(避免把 A100 之类误判成 CPU 而静默降速)
  esac
fi

if [[ -n "$_gpu_profile" ]]; then
  echo ">> [sd] 加载 profile: $_gpu_profile (GPU=${_gpu_name:-无})"
  source_env_if_exists ".env.${_gpu_profile}"
else
  echo ">> [sd] 未匹配 profile, 使用脚本/默认值"
fi
unset _gpu_profile _gpu_name

# ============================================================
# Platform profile: CPU (未探测到 NVIDIA GPU)
# stable-diffusion.cpp 引擎专用（sd/ 目录）
#
# 用法:
#   由 sd/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=cpu, 或未设置
#   GPU_PROFILE 且 nvidia-smi 不可用时), 或手动: source .env.cpu
# 以下变量均写成 ${VAR:-默认}: 外部(命令行/父 shell/.envrc)已设置时保持原值, 未设置才用本 profile 的默认值
# ============================================================

export SD_DIR="${SD_DIR:-/content/stable-diffusion.cpp}"

# ---- 默认模型: SD1.5 单文件 safetensors ----
# 纯 CPU 跑 Qwen-Image-2.1 三件套(十余 GB)不现实, 换成 SD1.5 单文件(~4.3GB, 512x512)
# 用 --model/-m 加载全模型, 无需单独的 VAE / 文本编码器组件。
export SD_MODEL_REPO="${SD_MODEL_REPO:-stable-diffusion-v1-5/stable-diffusion-v1-5}"
export SD_MODEL_FILE="${SD_MODEL_FILE:-v1-5-pruned-emaonly.safetensors}"

# 显式清空组件式模型, 避免继承到 GPU profile 的三件套
export SD_DIFFUSION_MODEL_REPO="${SD_DIFFUSION_MODEL_REPO:-}"
export SD_DIFFUSION_MODEL_FILE="${SD_DIFFUSION_MODEL_FILE:-}"
export SD_VAE_REPO="${SD_VAE_REPO:-}"
export SD_VAE_FILE="${SD_VAE_FILE:-}"
export SD_LLM_REPO="${SD_LLM_REPO:-}"
export SD_LLM_FILE="${SD_LLM_FILE:-}"

# ---- 生成默认参数(SD1.5 惯例, 小图省内存) ----
export SD_STEPS="${SD_STEPS:-20}"
export SD_CFG_SCALE="${SD_CFG_SCALE:-7.5}"
export SD_SAMPLING_METHOD="${SD_SAMPLING_METHOD:-euler_a}"
export SD_WIDTH="${SD_WIDTH:-512}"
export SD_HEIGHT="${SD_HEIGHT:-512}"

# CPU 推理线程数: -1/空 = 由 sd.cpp 按物理核心数自行决定
export SD_THREADS="${SD_THREADS:--1}"

# ---- 服务监听 ----
export SD_HOST="${SD_HOST:-0.0.0.0}"
export SD_PORT="${SD_PORT:-30000}"

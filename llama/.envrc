# shellcheck shell=bash
# llama.cpp 引擎目录的 direnv 配置
# 进入本目录时自动生效: 继承根目录 .envrc, 并按 GPU_PROFILE 加载对应 profile

# 继承父目录(根)的 .envrc(含 API_KEY / MODEL_REPO / BORE_PORT / dotenv 等)
source_up

# 将 llama 二进制目录加入 PATH(编译版与官方预编译版安装路径一致: $LLAMA_DIR/build/bin)
LLAMA_DIR="${LLAMA_DIR:-/content/llama.cpp}"
export LLAMA_DIR
PATH_add "$LLAMA_DIR/build/bin"

# ---- llama 引擎专属配置(均带 LLAMA_ 前缀) ----
# 空默认: launch.sh 中 LLAMA_* 不存在时回退到 API_KEY / MODEL_REPO 等通用变量
export LLAMA_API_KEY="${LLAMA_API_KEY:-}"
export LLAMA_MODEL_REPO="${LLAMA_MODEL_REPO:-}"
# LLAMA_QUANT 无默认值(launch.sh 强制非空); 需由 profile 或命令行提供
export LLAMA_QUANT="${LLAMA_QUANT:-}"
# LLAMA_CTX / LLAMA_NGL 不在这一层给默认值: .env.cpu 需要能覆盖它们(GPU 的 999/0 会
# 被 ${VAR:-默认} 当成"已设置"而保留), 故其兜底默认值统一放在下方 profile 加载之后
# 模型路径: 基础盘前缀(留空=用 launch.sh 默认 /content/models); 本仓库目录 = <ROOT>/<repo名>
export LLAMA_MODEL_ROOT="${LLAMA_MODEL_ROOT:-}"
export LLAMA_VISION="${LLAMA_VISION:-0}"

# 按 GPU_PROFILE 加载对应 profile(g4 / t4 / cpu)
# 未显式设置时自动探测: 有 NVIDIA 显卡按型号推导(g4 / t4); 没有 nvidia-smi 或无输出则落到 cpu
_gpu_profile="${GPU_PROFILE:-}"
if [[ -z "$_gpu_profile" ]]; then
  _gpu_name=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    _gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)
  fi
  case "$_gpu_name" in
    *T4*)  _gpu_profile=t4 ;;
    *G4*|*L4*|*Blackwell*) _gpu_profile=g4 ;;   # Blackwell 系(如 RTX PRO 6000)按 G4 处理
    "")    _gpu_profile=cpu ;;                  # 无 nvidia-smi 或无输出: 纯 CPU 平台
    # 有显卡但型号未识别: 不套用任何 profile(避免把 A100 之类误判成 CPU 而静默降速)
  esac
fi

if [[ -n "$_gpu_profile" ]]; then
  echo ">> [llama] 加载 profile: $_gpu_profile (GPU=${_gpu_name:-无})"
  source_env_if_exists ".env.${_gpu_profile}"
else
  echo ">> [llama] 未匹配 profile, 使用脚本/默认值"
fi
unset _gpu_profile _gpu_name

# profile 未覆盖时的兜底默认值(放在这里, 才允许 .env.cpu 覆盖为 0 / 8192)
export LLAMA_CTX="${LLAMA_CTX:-0}"      # 0=由 llama.cpp 按空闲显存自动拟合上下文
export LLAMA_NGL="${LLAMA_NGL:-999}"    # 999=全部层卸载到 GPU

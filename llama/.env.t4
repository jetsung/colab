# ============================================================
# GPU profile: T4 (NVIDIA Turing, sm_75, 16GB, 显存最小)
# llama.cpp 引擎专用（llama/ 目录）
#
# 用法:
#   由 llama/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=t4 时)
#   或手动: source gpu_t4.env
# 以下变量均写成 ${VAR:-默认}: 外部(命令行/父 shell/.envrc)已设置时保持原值, 未设置才用本 profile 的默认值
# ============================================================

# llama.cpp 编译目标架构（install.sh 使用）
export LLAMA_CUDA_ARCH="${LLAMA_CUDA_ARCH:-75}"

# T4 只有 16GB：最低量化; LLAMA_CTX=0 自动按显存拟合上下文（按需调整）
export LLAMA_QUANT="${LLAMA_QUANT:-UD-IQ1_M}"
export LLAMA_CTX="${LLAMA_CTX:-0}"
export LLAMA_NGL="${LLAMA_NGL:-999}"

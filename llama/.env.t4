# ============================================================
# GPU profile: T4 (NVIDIA Turing, sm_75, 16GB, 显存最小)
# llama.cpp 引擎专用（llama/ 目录）
#
# 用法:
#   由 llama/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=t4 时)
#   或手动: source gpu_t4.env
# 以下变量均可由外部环境变量提供, 未提供时 launch.sh 使用自身默认值
# ============================================================

# llama.cpp 编译目标架构（install.sh 使用）
export LLAMA_CUDA_ARCH=75

# T4 只有 16GB：最低量化 + 最小上下文（按需调整）
export LLAMA_QUANT=UD-IQ1_M
export LLAMA_CTX=1024
export LLAMA_NGL=999

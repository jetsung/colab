# ============================================================
# Platform profile: CPU (未探测到 NVIDIA GPU)
# llama.cpp 引擎专用（llama/ 目录）
#
# 用法:
#   由 llama/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=cpu, 或未设置
#   GPU_PROFILE 且 nvidia-smi 不可用时), 或手动: source .env.cpu
# 以下变量均写成 ${VAR:-默认}: 外部(命令行/父 shell/.envrc)已设置时保持原值, 未设置才用本 profile 的默认值
# ============================================================

# 纯 CPU 推理: 不做 GPU 卸载
export LLAMA_NGL="${LLAMA_NGL:-0}"

# 线程数: 0/空 = 由 llama.cpp 按核心数自行决定(此时 launch.sh 不传 -t)
# 超线程机器上显式设为物理核心数通常更快, 例: LLAMA_THREADS=4
export LLAMA_THREADS="${LLAMA_THREADS:-0}"

# CPU 上 KV cache 走内存: LLAMA_CTX=0 会按模型的训练上下文(可达 256K)建池, 极易 OOM。
# Colab CPU 会话内存约 12GB, 这里给 8192 的保守值; 内存充裕可按需调大。
export LLAMA_CTX="${LLAMA_CTX:-8192}"

# 量化档: 内存远小于显存, 用较低的 Q4_K_M。launch.sh 强制非空, 必须由 profile 或命令行给出。
export LLAMA_QUANT="${LLAMA_QUANT:-Q4_K_M}"

# CPU 内存有限, 建议换小模型(按需调整; 不设置则用 .envrc/.env 的 LLAMA_MODEL_REPO / MODEL_REPO)
# 注意: 默认仓库 unsloth/Qwen3.8-Flash-Next-GGUF 是 80B-A3B 的 MoE, Q4 也有约 45GB,
#       CPU 会话装不下, 请显式指定一个能放进内存的小模型。
# export LLAMA_MODEL_REPO=Qwen/Qwen3-8B-GGUF

# ============================================================
# GPU profile: T4 (16 GB, Turing)
# All defaults preserve values supplied by the caller.
# ============================================================

# Keep more headroom on the smallest supported GPU profile.
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.80}"
# T4 has the least memory, so allow fewer concurrent sequences.
export VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-256}"
# T4 users may need a smaller model/context; configure it in .env when needed.
# export VLLM_MAX_MODEL_LEN=8192

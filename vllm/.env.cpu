# ============================================================
# Platform profile: CPU (no NVIDIA GPU detected)
# vLLM engine only (vllm/ directory)
#
# Loaded by vllm/.envrc via source_env_if_exists when GPU_PROFILE=cpu, or when
# GPU_PROFILE is unset and nvidia-smi is unavailable.
# All defaults preserve values supplied by the caller.
# ============================================================

# CPU platform: pin the device explicitly so vLLM never probes for CUDA.
# Set VLLM_DEVICE= (empty) to hand detection back to vLLM.
export VLLM_DEVICE="${VLLM_DEVICE:-cpu}"

# CPU has no GPU memory to budget. --gpu-memory-utilization is dropped by
# launch.sh on CPU; KV cache instead comes out of system RAM and is capped by
# this value (GiB).
export VLLM_CPU_KVCACHE_SPACE="${VLLM_CPU_KVCACHE_SPACE:-8}"

# CPU throughput is an order of magnitude below a GPU, so keep the batch small.
export VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-64}"

# An unbounded model context (256K on Qwen3) would blow up the KV cache in RAM.
export VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-8192}"

# Reserve one core for the front-end process (official CPU serving recommendation:
# without it the API server competes with the inference threads and can starve).
export VLLM_CPU_NUM_OF_RESERVED_CPU="${VLLM_CPU_NUM_OF_RESERVED_CPU:-1}"

# Optional: pin OMP threads per core rank, e.g. "0-7" or "auto".
# export VLLM_CPU_OMP_THREADS_BIND=auto

# CPU RAM is far tighter than GPU memory: prefer a small model here.
# Qwen/Qwen3.8-27B is ~54 GB in bf16 and will not fit a Colab CPU session.
# export VLLM_MODEL_REPO=Qwen/Qwen3-8B

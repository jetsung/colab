# shellcheck shell=bash
# vLLM 引擎目录的 direnv 配置
# 进入本目录时继承根 .envrc, 并按 GPU_PROFILE 加载对应 profile

source_up

# 模型优先使用 VLLM_MODEL_REPO, 未设置时由 launch.sh 回退根 MODEL_REPO
export VLLM_MODEL_REPO="${VLLM_MODEL_REPO:-}"
# 留空表示继承根 MODEL_ROOT, 再由 launch.sh 兜底到 /content/models
export VLLM_MODEL_ROOT="${VLLM_MODEL_ROOT:-}"
# venv 路径需与 colab.sh install vllm 保持一致
export VLLM_VENV_DIR="${VLLM_VENV_DIR:-/tmp/vllm/venv}"
export VLLM_HOST="${VLLM_HOST:-0.0.0.0}"
export VLLM_PORT="${VLLM_PORT:-30000}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-}"
export VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-}"

# 未显式设置 GPU_PROFILE 时自动探测: 有 NVIDIA 显卡按型号推导(g4 / t4);
# 没有 nvidia-smi 或无输出则落到 cpu
_gpu_profile="${GPU_PROFILE:-}"
if [[ -z "$_gpu_profile" ]]; then
  _gpu_name=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    _gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)
  fi
  case "$_gpu_name" in
    *T4*)                  _gpu_profile=t4 ;;
    *G4*|*L4*|*Blackwell*) _gpu_profile=g4 ;;
    "")                    _gpu_profile=cpu ;;   # 无 nvidia-smi 或无输出: 纯 CPU 平台
    # 有显卡但型号未识别: 不套用任何 profile(避免把 A100 之类误判成 CPU 而静默降速)
  esac
fi

if [[ -n "$_gpu_profile" ]]; then
  echo ">> [vllm] 加载 profile: $_gpu_profile (GPU=${_gpu_name:-无})"
  source_env_if_exists ".env.${_gpu_profile}"
else
  echo ">> [vllm] 未匹配 profile, 使用脚本/默认值"
fi
unset _gpu_profile _gpu_name

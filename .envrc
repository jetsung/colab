# shellcheck shell=bash
PATH_add /root/.opencode/bin

# API 鉴权密钥默认值(简短, 便于本地快速使用); 放在 dotenv 之前, .env 中的 API_KEY 优先生效
export API_KEY="${API_KEY:-sk-default}"

# 模型默认值; 放在 dotenv 之前, .env 中已定义的 MODEL_REPO 优先生效
export MODEL_REPO="${MODEL_REPO:-Qwen/Qwen3.8-27B}"

# 模型基础盘前缀(两引擎共用, 必须是本地盘): 换持久化盘只改这一层, 各引擎在其下按仓库分目录
#   <MODEL_ROOT>/<repo名>/...  ; 引擎侧可用 LLAMA_MODEL_ROOT / SGLANG_MODEL_ROOT 单独覆盖
# 不支持 Google Drive 作为模型目录: 路径以 /content/drive 开头时引擎启动直接报错, 也不会
#   自动复制/降级 —— Drive 只作冷存储, 权重搬运用 ./colab.sh sync 手动执行(pull/push)。
export MODEL_ROOT="${MODEL_ROOT:-/content/models}"
# 本地工作盘前缀(仅 ./colab.sh sync 使用): sync 的本地端根目录
export MODEL_LOCAL_ROOT="${MODEL_LOCAL_ROOT:-/content/models}"

# bore 公网隧道端口默认值; 放在 dotenv 之前, .env 中已定义的 BORE_PORT 优先生效
export BORE_PORT="${BORE_PORT:-65535}"

# bore 隧道鉴权密钥, 默认为空(不鉴权); .env 中已定义的 BORE_SECRET 优先生效
export BORE_SECRET="${BORE_SECRET:-}"

# bore 服务端地址默认值; 放在 dotenv 之前, .env 中已定义的 BORE_SERVER 优先生效
export BORE_SERVER="${BORE_SERVER:-bore.pub}"

# 密钥等变量从同目录 .env 加载(.env 含敏感信息, 已被 .gitignore 忽略)
dotenv_if_exists

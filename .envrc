# shellcheck shell=bash
PATH_add /root/.opencode/bin

# API 鉴权密钥默认值(简短, 便于本地快速使用); 放在 dotenv 之前, .env 中的 API_KEY 优先生效
export API_KEY="${API_KEY:-sk-default}"

# 模型默认值; 放在 dotenv 之前, .env 中已定义的 MODEL_REPO 优先生效
export MODEL_REPO="${MODEL_REPO:-Qwen/Qwen3.8-27B}"

# bore 公网隧道端口默认值; 放在 dotenv 之前, .env 中已定义的 BORE_PORT 优先生效
export BORE_PORT="${BORE_PORT:-65535}"

# 密钥等变量从同目录 .env 加载(.env 含敏感信息, 已被 .gitignore 忽略)
dotenv

# ============================================================
# Platform profile: CPU (未探测到 NVIDIA GPU)
# SGLang 引擎专用（sglang/ 目录）
#
# 用法:
#   由 sglang/.envrc 经 source_env_if_exists 自动加载(GPU_PROFILE=cpu, 或未设置
#   GPU_PROFILE 且 nvidia-smi 不可用时), 或手动: source .env.cpu
# 以下变量均写成 ${VAR:-默认}: 外部(命令行/父 shell/.envrc)已设置时保持原值, 未设置才用本 profile 的默认值
# ============================================================

# 启用 CPU 引擎: 官方要求必须设置该环境变量, 否则 --device cpu 不会走 CPU 后端
export SGLANG_USE_CPU_ENGINE="${SGLANG_USE_CPU_ENGINE:-1}"

# 显式指定 CPU 后端; 置空(SGLANG_DEVICE=)则交回 sglang 自行探测
export SGLANG_DEVICE="${SGLANG_DEVICE:-cpu}"

# 投机解码(EAGLE/MTP)在 CPU 上得不偿失: 显式置空即关闭(launch.sh 用 ${VAR+x} 判定,
# 空串 = 已显式设置 = 关闭, 不会被 config.json 的 MTP 层推导结果覆盖)
export SGLANG_SPECULATIVE_ALGORITHM="${SGLANG_SPECULATIVE_ALGORITHM:-}"

# CPU 上 KV cache 走内存: SGLANG_CTX=0 会按模型训练上下文(可达 256K)建池, 极易 OOM。
# Colab CPU 会话内存约 12GB, 这里给 8192 的保守值; 内存充裕可按需调大。
export SGLANG_CTX="${SGLANG_CTX:-8192}"

# 注: 以下 GPU 专属参数由 launch.sh 在 CPU 平台自动跳过, 无需在此设置:
#   --attention-backend flashinfer   # FlashInfer 是 CUDA 专用
#   --kv-cache-dtype fp8_e4m3        # CPU 不支持 fp8 KV
#   --mem-fraction-static            # CPU 无静态显存占比概念

# CPU 内存有限, 建议换小模型(按需调整; 不设置则用 .envrc/.env 的 SGLANG_MODEL_REPO / MODEL_REPO)
# 注意: 默认仓库 Qwen/Qwen3.8-27B 是 27B 稠密模型, bf16 权重约 54GB, CPU 会话装不下。
# export SGLANG_MODEL_REPO=Qwen/Qwen3-8B

# shellcheck shell=bash
# SGLang 引擎目录的 direnv 配置
# 进入本目录时自动生效: 继承根目录 .envrc, 并按 GPU_PROFILE 加载对应 profile

# 继承父目录(根)的 .envrc(含 API_KEY / MODEL_REPO / BORE_PORT / dotenv 等全局配置)
source_up

# ---- SGLang 引擎专属配置(原根 .envrc 下沉) ----
# 模型: 优先 SGLANG_MODEL_REPO, 回退通用 MODEL_REPO(launch.sh 使用)
export SGLANG_MODEL_REPO="${SGLANG_MODEL_REPO:-}"
# 上下文长度(默认空=不传 --context-length, 由模型默认)
# 参考: meta-models/Muse-Glimmer-30B 上下文 128K(131072), Qwen/Qwen3.8-27B 上下文 256K(262144)
export SGLANG_CONTEXT_LENGTH="${SGLANG_CONTEXT_LENGTH:-}"

# 投机解码算法: 启动时按模型 config.json 是否内置 MTP 层自动判断 EAGLE 支持(Qwen3→EAGLE; Muse-Glimmer-30B 无 MTP→关闭)
# 如需显式覆盖, 在 .env 中设置 SGLANG_SPECULATIVE_ALGORITHM(如 =EAGLE 启用, 置空关闭)
# 投机解码时的最大并发运行请求数: 脚本默认显式传 48(sglang 自动重置值, 显式传入可消除启动提示)
# 如需调整, 在 .env 中设置 SGLANG_MAX_RUNNING_REQUESTS

# 以下参数默认空=由启动脚本依据缓存/本地模型 config.json 自动推导(模型家族、上下文长度等),
# .env 中已定义的同名变量优先生效
# export SGLANG_SERVED_NAME="${SGLANG_SERVED_NAME:-}"          # 默认=模型路径末段; 如需自定义 API 模型名在此设置
# export SGLANG_REASONING_PARSER="${SGLANG_REASONING_PARSER:-}"  # 默认按家族推导(qwen3/deepseek_v3/glm45); 显式指定覆盖
# export SGLANG_TOOL_CALL_PARSER="${SGLANG_TOOL_CALL_PARSER:-}"  # 默认按家族推导(qwen3_coder/deepseek_v3/glm45); 显式指定覆盖
# export SGLANG_CHAT_TEMPLATE_KWARGS="${SGLANG_CHAT_TEMPLATE_KWARGS:-}"  # 默认按家族推导(如 qwen→{"enable_thinking":true}); 显式指定覆盖

# 按 GPU_PROFILE 加载对应 profile(如 GPU_PROFILE=g4 / t4)
# 未显式设置时, 按 nvidia-smi 探测的显卡型号自动推导(g4 / t4)
_gpu_profile="${GPU_PROFILE:-}"
if [[ -z "$_gpu_profile" ]]; then
  _gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)
  case "$_gpu_name" in
    *T4*)  _gpu_profile=t4 ;;
    *G4*|*L4*) _gpu_profile=g4 ;;
  esac
fi

if [[ -n "$_gpu_profile" ]]; then
  echo ">> [sglang] 加载 GPU profile: $_gpu_profile (GPU=${_gpu_name:-未知})"
  source_env_if_exists ".env.${_gpu_profile}"
else
  echo ">> [sglang] 未匹配 GPU profile, 使用脚本/默认值"
fi
unset _gpu_profile _gpu_name
